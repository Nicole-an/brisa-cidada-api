# Copie para .env (não versionado) e preencha. Nunca faça commit do .env.
# Senha do usuário "sa" do SQL Server local (mín. 8 caracteres com maiúsculas, minúsculas, números e símbolos).
MSSQL_SA_PASSWORD=

# Perfil Spring usado pela API no docker compose (dev carrega dados fictícios de demonstração).
SPRING_PROFILES_ACTIVE=dev
